    <!-- Onboarding -->
    <string name="setup_onboarding_title">Welcome to Aufmachen</string>
    <string name="setup_step_of">Step %1$d of %2$d</string>
    <string name="setup_intro_title">Move off your old address, calmly</string>
    <string name="setup_intro_body">Aufmachen reads the headers of your old mailbox, works out which services matter, and walks you through changing each one to your new Tuta address. Then it keeps watching the old inbox for anything you missed.</string>
    <string name="setup_intro_does">What it does</string>
    <string name="setup_intro_does_1">Ranks every service that ever mailed you.</string>
    <string name="setup_intro_does_2">Guides you through each change and checks it.</string>
    <string name="setup_intro_does_3">Warns you when an old address still gets mail.</string>
    <string name="setup_intro_never">What it never does</string>
    <string name="setup_intro_never_1">It never downloads message bodies. Only sender, recipient, subject, date and flags.</string>
    <string name="setup_intro_never_2">It has no server. Everything stays on this phone.</string>
    <string name="setup_intro_never_3">It never changes, moves or deletes mail. The mailbox is read-only. It sends mail only when you confirm that exact message.</string>

