    <string name="detail_changed_title">Mark as changed?</string>
    <string name="detail_changed_text">%1$s moves to Changed (unverified). From now on, any mail from it to the old mailbox raises a watchdog alert. Nothing is sent.</string>
    <string name="detail_changed_ok">Mark changed</string>
    <string name="detail_deleted_title">Mark as deleted?</string>
    <string name="detail_deleted_text">%1$s moves to Deleted. Any later mail from it to the old mailbox raises a watchdog alert. Nothing is sent and your account is not deleted by this.</string>
    <string name="detail_deleted_ok">Mark deleted</string>
    <string name="detail_ignore_title">Ignore this service?</string>
    <string name="detail_ignore_text">%1$s moves to Ignored and the watchdog stops watching it. Nothing is sent.</string>
