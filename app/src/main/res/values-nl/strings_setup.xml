    <!-- Onboarding -->
    <string name="setup_onboarding_title">Welkom bij Aufmachen</string>
    <string name="setup_step_of">Stap %1$d van %2$d</string>
    <string name="setup_intro_title">Verhuis rustig weg van je oude adres</string>
    <string name="setup_intro_body">Aufmachen leest de headers van je oude mailbox, bepaalt welke diensten belangrijk zijn en helpt je elke dienst naar je nieuwe Tuta-adres te zetten. Daarna blijft het de oude inbox in de gaten houden voor alles wat je mist.</string>
    <string name="setup_intro_does">Wat het doet</string>
    <string name="setup_intro_does_1">Rangschikt elke dienst die ooit naar je heeft gemaild.</string>
    <string name="setup_intro_does_2">Begeleidt je bij elke wijziging en controleert die.</string>
    <string name="setup_intro_does_3">Waarschuwt je als een oud adres nog mail krijgt.</string>
    <string name="setup_intro_never">Wat het nooit doet</string>
    <string name="setup_intro_never_1">Het downloadt nooit de inhoud van berichten. Alleen afzender, ontvanger, onderwerp, datum en vlaggen.</string>
    <string name="setup_intro_never_2">Het heeft geen server. Alles blijft op deze telefoon.</string>
    <string name="setup_intro_never_3">Het wijzigt, verplaatst of verwijdert nooit mail. De mailbox is alleen-lezen. Het verstuurt alleen mail als je precies dat bericht bevestigt.</string>

